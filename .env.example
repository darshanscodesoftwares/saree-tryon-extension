# Copy this to `.env` and fill it in. `.env` is gitignored and must stay that
# way: everything else in this repository is public, and a key on a public
# server is a key someone else can spend.
#
#   cp .env.example .env
#   npm start          <- reads .env if it is there
#
# On Render these are environment variables in the dashboard instead. Never
# in src/config.js, which is committed.

# The paid image route. Without this the server runs on the extension route
# exactly as it always has.
OPENAI_API_KEY=

# Holds the route switch shut. Without it, anyone who can reach this server
# can flip it into API mode and start spending. Any long random string.
CONTROL_KEY=

# What the API is asked for. Defaults are gpt-image-2.5-sunburst, low,
# 1024x1536 - low while the route is being proved.
# IMAGE_MODEL=gpt-image-2.5-sunburst
# IMAGE_QUALITY=low
# IMAGE_SIZE=1024x1536
