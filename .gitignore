.DS_Store
node_modules/
# Customer captures must never be committed. The extension does not write any
# to disk, but anything exported by hand lands here.
captures/

# A development certificate is per-machine and is not shared.
certs/

# Documents written for people rather than for the repository - costings,
# proposals, anything rendered to PDF. They are regenerated from source, and
# a binary that changes wholesale on every edit does not belong in history.
*.pdf

# The API key and anything else that is per-machine and secret. The server
# reads this when it starts; nothing in src/ ever should.
.env
